# Copy to .env and fill in real values. Never commit .env.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b     # optional; this is the default
SECRET_KEY=change-me

DB_HOST=localhost
DB_PORT=3306
DB_NAME=recipeai
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# Meal planner (recipe search + grocery list)
RECIPES_CSV=data/recipes.csv
RECIPES_LIMIT=5000
RECIPES_EMBEDDINGS_CACHE=data/recipe_embeddings.npz

# BERT parser: a local model folder (e.g. fixed/model) or a Hugging Face Hub id (falls back to ./bert_recipe_model)
BERT_MODEL_ID=fixed/model
# Only needed if the Hub repo is private
HF_TOKEN=
RECIPES_SUBSET_CACHE=data/recipes_subset.json
